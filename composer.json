{
  "name": "ondewo/sip-client-php",
  "description": "ONDEWO SIP (SIP Telephony) gRPC client for PHP, generated from the ondewo-sip-api protocol buffer definitions",
  "type": "library",
  "keywords": ["ondewo", "sip", "grpc", "protobuf", "client"],
  "homepage": "https://github.com/ondewo/ondewo-sip-client-php",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "ONDEWO GmbH",
      "email": "office@ondewo.com",
      "homepage": "https://www.ondewo.com"
    }
  ],
  "support": {
    "issues": "https://github.com/ondewo/ondewo-sip-client-php/issues",
    "source": "https://github.com/ondewo/ondewo-sip-client-php"
  },
  "require": {
    "ext-grpc": "*",
    "google/protobuf": "4.33.6",
    "grpc/grpc": "1.82.0",
    "php": ">=8.1.0"
  },
  "autoload": {
    "classmap": ["src/"],
    "psr-4": {
      "Ondewo\\Sip\\Auth\\": "auth/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ondewo\\Sip\\Tests\\": "tests/"
    }
  },
  "version": "5.4.0"
}
