# ---------------------------------------------------------------------------
# NOTE: src/ - the generated proto stubs - is deliberately NOT ignored.
# This repository IS the composer package: Packagist serves the tree of a git
# tag verbatim and composer has no build step, so a consumer of
# `ondewo/sip-client-php` receives exactly what is committed here. Stubs
# that are not committed simply do not exist for anybody who installs the
# package. The same applies to the other ONDEWO clients that publish generated
# code (the python client commits its *_pb2.py, the node clients their api/).
# ---------------------------------------------------------------------------

# Composer artifacts. vendor/ is regenerated by `composer install`; the lock is
# not committed because this is a library (its consumers resolve their own
# versions) and because the compiler image writes a --no-dev lock.
/vendor/
/composer.lock
/composer.phar

# The dev tool chain (PHPUnit + the coverage gate) is its own composer project - see
# tools/README.md. Its lock is NOT committed: the phpunit constraint has to re-resolve per
# interpreter across the php 8.1 - 8.4 CI matrix.
/tools/vendor/
/tools/composer.lock

# Composer / PHP tool caches
.composer/
.php-cs-fixer.cache
.php_cs.cache
.phpunit.result.cache
/.phpunit.cache/

# Test + coverage output
/build/
/coverage/
/.phpdoc/

# Output of the proto compiler's own example scripts and of its Makefile `run`
# target, in case the image is driven by hand from the submodule
/lib/
/output/

# Credentials clone created by `make ondewo_release`
/ondewo-devops-accounts/

# Editors
.idea/
.vscode/
*.swp

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db
